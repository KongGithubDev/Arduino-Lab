{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/simulator/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/simulator/models/:file*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Type", "value": "model/gltf-binary" }
      ]
    }
  ]
}
